{
  "name": "phd-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run generate && next dev",
    "build": "npm run generate && next build",
    "build:pages": "node scripts/export-static.mjs",
    "start": "next start",
    "lint": "eslint",
    "smoke": "node --experimental-strip-types --import ./scripts/ts-register.mjs scripts/admin-smoke.mjs",
    "covers": "node scripts/generate-covers.mjs",
    "gen:data": "node scripts/generate-content.mjs",
    "generate": "node scripts/generate-content.mjs && node scripts/generate-covers.mjs && node scripts/generate-notebook.mjs && node scripts/generate-pdfs.mjs"
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@next/swc-win32-x64-msvc": "^16.3.0",
    "@types/three": "^0.185.4",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "next": "16.3.0",
    "next-mdx-remote-client": "^2.1.12",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
